// Prisma schema for the Legal Document Workspace.
//
// Local-first SQLite database. The connection string is a plain file path
// (not a secret), hardcoded here so a fresh clone runs `pnpm prisma migrate`
// with zero env setup — matching the project's "zero-setup local DB" goal.
// The dev.db file is gitignored.
//
// Pinned to Prisma 6 (classic prisma-client-js generator) on purpose: the
// simplest, best-documented setup for a local SQLite demo. Prisma 7's
// driver-adapter + prisma.config.ts approach adds moving parts we don't need
// at this scale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

/// An uploaded source document (PDF or DOCX) parsed to plain text.
model Document {
  id            String   @id @default(cuid())
  filename      String
  title         String? // optional friendly display name; falls back to filename
  mimeType      String
  extractedText String
  tokenCount    Int
  /// true when tokenCount is a rough char-based fallback (the live
  /// Anthropic count_tokens call failed at upload time), not an exact count.
  tokenCountEstimated Boolean @default(false)
  createdAt           DateTime @default(now())
}

/// A single Assistant conversation. Groups its messages in order.
/// Exactly one session is ACTIVE (archivedAt = null) at a time (#22):
/// "New session" archives it rather than deleting — the session-list UI
/// (#26) will browse the archive.
model ChatSession {
  id             String    @id @default(cuid())
  title          String? // optional friendly name for the conversation
  createdAt      DateTime  @default(now())
  /// set when "New session" retires this thread; null = the active thread
  archivedAt     DateTime?
  /// JSON string[] of Document ids selected when the last turn was sent —
  /// restored with the thread so the conversation keeps its context.
  selectedDocIds String    @default("[]")
  messages       Message[]
}

/// One turn in a ChatSession. `role` is a plain string ("user" | "assistant"),
/// matching the AI SDK's role values — SQLite has no native enum type.
/// `content` holds the FULL AI SDK UIMessage as JSON (parts + metadata +
/// citation data parts) so a restored thread is byte-faithful (#22); the
/// row id mirrors the UIMessage id.
model Message {
  id            String      @id @default(cuid())
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  chatSessionId String
  role          String
  content       String
  /// 0-based order within the session — replace-all writes burst in within
  /// the same millisecond, so createdAt alone cannot order a thread.
  position      Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([chatSessionId])
}
